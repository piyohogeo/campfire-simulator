  "scenario": "production_four",
  "geometry_variant": "phase6er_corrected",
  "point_policy": "allow_self_center",
  "point_offset_m": -0.0125,
  "support_radius_m": 0.05,
  "collision_enabled": true,
  "point_filtering_enabled": true,
  "source_scales": {"fuel": 1.0, "temperature": 1.0, "smoke": 1.0},
  "sample_frames": [30, 60, 90, 120],
  "startup_order": [
    "extension/interface access", "offline complete stage and payload authoring", "USD context connection",
    "active viewport acquisition", "60 renderer viewport frames", "Flow interface acquisition",
    "timeline stop and time reset", "12 Kit updates", "timeline play", "120 post-play Kit updates"
  ],
  "conditions": [
    {"id": "P0_no_readback", "readback_mode": "none", "maximum_frame": 120},
    {"id": "P1_no_readback_repeat", "readback_mode": "none", "maximum_frame": 120, "requires": ["P0_representative_ingestion_and_normal_exit"]}
  ],
  "classification": {
    "classification_frame": 60,
    "final_frame": 120,
    "representative_active_blocks": 128,
    "small_field_minimum_blocks": 20,
    "small_field_maximum_blocks": 32,
    "expected_point_revision": 1,
    "expected_total_point_count": 1440,
    "expected_active_point_count": 1344,
    "minimum_fuel_sum": 1000.0,
    "representative_ingestion": "fresh frame/update/timeline samples through frame 120 and >=128 active blocks by frame 60",
    "small_field_ingestion": "fresh frame/update/timeline samples but every frame through 60 remains within 20..32 blocks",
    "stale_telemetry": "frame, monotonic timestamp, Kit update number, or timeline time fails to advance",
    "no_source": "Emitter enabled state, Point revision/count, or positive fuel input is absent",
    "indeterminate": "missing markers, incomplete history, resource/lifecycle failure, or neither predeclared occupancy class"
  },
  "branching": {
    "automatic_retry": false,
    "run_second_only_after_first_representative": true,
    "stop_if_two_processes_split": true,
    "stop_after_two_representative_processes": true,
    "public_field_check_in_this_contract": false,
    "ordering_or_cooldown_ablation_in_this_contract": false
  },
  "required_startup_markers": [
    "startup_extension_ready", "offline_stage_complete", "usd_context_connection_started",
    "usd_context_connection_complete", "startup_live_point_emitter_contract_complete",
    "renderer_readiness_started", "renderer_readiness_complete", "flow_interface_acquire_started",
    "flow_interface_acquire_complete", "pre_timeline_updates_started", "pre_timeline_updates_complete",
    "timeline_play_request_before", "timeline_playing", "startup_frame_sample"
  ],
  "lifecycle": {
    "renderer_pre_close_drain_updates": 8,
    "renderer_post_close_drain_updates": 4,
    "timeline_stop_confirmation_updates": 12,
    "stage_close_timeout_seconds": 180,
