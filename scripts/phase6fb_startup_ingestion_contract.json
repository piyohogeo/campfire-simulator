{
  "schema": "campfire.phase6fb.point-emitter-startup-ingestion-contract.v1",
  "phase": "phase6fb",
  "declared_before_runtime": true,
  "history": {
    "safe_commit": "857ab8e",
    "phase6ey": "frozen qualified; no reclassification",
    "phase6ez": "frozen C1 stationarity safe stop; zero-copy remains an observation only",
    "phase6fa": "frozen safe stop; D1 was 24 blocks before readback and corrected D0 later stopped at stage close",
    "prior_population_reuse": false
  },
  "purpose": "locate the first pre-readback startup boundary separating a representative four-log Flow field from a fresh 24-block field",
