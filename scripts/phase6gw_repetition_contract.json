      "same_signature_and_boundary_consecutive_count": 5
    }
  },
  "classification_values": [
    "normal_exit", "startup_prerequisite_not_met", "python_or_harness_failure",
    "operation_failure", "windows_native_exception", "stage_close_timeout",
    "os_exit_timeout", "resource_limit", "cleanup_failure", "unknown_failure"
  ],
  "safety": {
    "kit_private_limit_bytes": 17179869184,
    "unique_tree_private_limit_bytes": 18253611008,
    "runner_private_limit_bytes": 536870912,
    "diagnostic_private_limit_bytes": 536870912,
    "available_physical_floor_bytes": 8589934592,
    "commit_headroom_floor_bytes": 8589934592,
    "stage_close_timeout_seconds": 180,
    "inner_timeout_seconds": 900,
    "outer_timeout_seconds": 1020,
    "minimum_free_disk_bytes": 21474836480,
    "stop_population_on": ["resource_limit", "cleanup_failure", "disk_pressure"]
  },
  "artifact_policy": {
    "aggregate_jsonl": "aggregate.jsonl",
    "heartbeat": "heartbeat.json",
    "sequence": "fixed_sequence.json",
    "compact_summary_name": "run_summary.json",
    "full_artifact_first_per_failure_signature": true,
    "later_same_signature_keeps_bounded_summary_and_references": true,
