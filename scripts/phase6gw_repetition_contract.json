      "readback_frames": [180],
      "readback_calls": 1,
      "volume_conversion_calls": 1,
      "bounded_public_metadata": true,
      "temporary_nanovdb_save": false,
      "sampling": false,
      "near_mesh_collector": false,
      "directional_flux": false
    },
    "B": {
      "name": "candidate_phase6gn_exact",
      "probe": "scripts/probe_phase6gn_supply_comparison.py",
      "sample_frames": [60, 120, 180, 360, 540, 600],
      "readback_frames": [180, 360, 540],
