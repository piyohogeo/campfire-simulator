{
  "schema": "campfire.phase6ev.r0-lifecycle-contract.v1",
  "phase": "phase6ev",
  "declared_before_runtime": true,
  "phase6eu_history": "frozen lifecycle safe stop; artifacts, invalid synchronous markers, partial plateau evidence, and unknown_shutdown_failure remain unchanged",
  "purpose": "establish normal shutdown for the readback-free four-log Flow baseline before resuming NanoVDB lifetime work",
  "production_neutral": true,
  "scenario": "production_four",
  "geometry_variant": "phase6er_corrected",
  "point_policy": "allow_self_center",
  "point_offset_m": -0.0125,
  "support_radius_m": 0.05,
  "collision_enabled": true,
  "point_filtering_enabled": true,
  "source_scales": {"fuel": 1.0, "temperature": 1.0, "smoke": 1.0},
  "lifecycle": {
    "calibration_enabled": true,
    "renderer_pre_close_drain_updates": 8,
    "renderer_post_close_drain_updates": 4,
    "timeline_stop_confirmation_updates": 12,
    "extension_marker": "omni.campfire.phasev3tg_shutdown",
    "normal_os_exit_required": true
  },
  "conditions": [
    {"id": "L0_short", "kind": "short_control", "sample_frames": [30, 60], "readback_mode": "none", "runs": 1, "requires": []},
    {"id": "R0_none", "kind": "frame320_baseline", "sample_frames": [30, 60, 90, 120, 150, 180, 200, 240, 280, 320], "readback_mode": "none", "runs": 3, "requires": ["L0_short"]},
    {"id": "R1_acquire_discard", "kind": "single_public_acquisition", "sample_frames": [30, 60, 90, 120, 150, 180, 200, 240, 280, 320], "readback_mode": "acquire_discard", "readback_frames": [60], "runs": 1, "requires": ["R0_none_3_of_3_normal_exit", "R0_none_plateau"]}
  ],
  "execution": {
    "automatic_retry": false,
    "r1_automatic_only_after_r0_gate": true,
    "maximum_processes": 5,
    "inner_absolute_timeout_seconds": 420,
    "outer_condition_timeout_seconds": 900
  },
  "plateau_contract": {
    "stability_frames": [240, 280, 320],
    "maximum_active_block_range_fraction": 0.15,
    "maximum_private_growth_bytes_per_second": 8388608,
    "minimum_resource_samples_in_stability_interval": 20,
    "require_non_monotonic_or_flat_private_series": true
  },
  "required_probe_markers": [
    "final_sample_complete", "measurement_complete", "timeline_stop_request_before",
    "timeline_stop_request_after", "timeline_stop_confirmed", "renderer_drain_started",
    "renderer_drain_complete", "flow_references_release_started", "flow_references_release_complete",
    "provider_readback_references_release_started", "provider_readback_references_release_complete",
    "stage_close_request_before", "stage_close_request_after", "usd_context_disconnected",
    "app_close_requested", "shutdown_complete"
  ],
  "required_extension_markers": ["extension_on_startup", "extension_on_shutdown_begin", "extension_on_shutdown_end"],
  "required_runner_markers": ["os_process_exit_observed"],
  "safety": {
    "runner_private_limit_bytes": 536870912,
    "diagnostic_private_limit_bytes": 536870912,
    "kit_private_limit_bytes": 15032385536,
    "unique_tree_private_limit_bytes": 17179869184,
    "physical_memory_floor_bytes": 8589934592,
    "commit_headroom_floor_bytes": 8589934592,
    "resource_sampling_seconds": 0.25,
    "gpu_sampling_ms": 1000
  },
  "r1_boundary": {
    "public_call": "get_latest_nanovdb_readback",
    "conversion": false,
    "aggregation": false,
    "json_or_npz_payload_persistence": false,
    "private_release_api": false,
    "bounded_type_and_identity_metadata_only": true
  }
}
