    def Xform "Joints"
    {
        def PhysicsFixedJoint "CollapseLogJoint"
        {
            custom string campfire:releaseReason = "crossSectionSupport"
            rel physics:body0 = </World/Logs/CollapseLog_A>
            rel physics:body1 = </World/Logs/CollapseLog_B>
