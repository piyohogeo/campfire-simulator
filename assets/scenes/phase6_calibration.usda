#usda 1.0
(
    customLayerData = {
        string "campfire:metric" = "time_to_ignition_seconds"
        string "campfire:phase" = "phase6"
        string "campfire:scene" = "nist_plywood_calibration"
    }
    defaultPrim = "World"
    endTimeCode = 100
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 60
    upAxis = "Z"
)

def Xform "World"
{
    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }

    def Cylinder "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.2
        color3f[] primvars:displayColor = [(0.08, 0.055, 0.035)]
        double radius = 7
        double3 xformOp:translate = (0, 0, -0.1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Camera "Camera"
    {
        float focalLength = 42
        matrix4d xformOp:transform = ( (0.7893522173763265, 0.6139406135149205, 0, 0), (-0.19983677906479044, 0.25693300165473054, 0.9455425397060149, -0), (0.5805069669315667, -0.7463661003405857, 0.3254985493151999, 0), (14.000000000000004, -18, 10, 0.9999999999999999) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }

    def "Lights"
    {
        def DomeLight "Dome"
        {
            color3f inputs:color = (0.42, 0.5, 0.7)
            float inputs:intensity = 650
        }

        def SphereLight "Key"
        {
            color3f inputs:color = (1, 0.35, 0.08)
            float inputs:intensity = 24000
            float inputs:radius = 0.35
            double3 xformOp:translate = (0, 0, 2.5)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Xform "CalibrationChart"
    {
        def Xform "Flux35"
        {
            def Cube "Observed"
            {
                custom int campfire:heatFluxKwM2 = 35
                custom string campfire:series = "observed"
                custom double campfire:valueSeconds = 47.1
                color3f[] primvars:displayColor = [(0.95, 0.72, 0.39)]
                double size = 1
                float3 xformOp:scale = (0.42, 0.42, 1.76625)
                double3 xformOp:translate = (-2.1, -1.15, 1.7662499999999999)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Cube "Baseline"
            {
                custom int campfire:heatFluxKwM2 = 35
                custom string campfire:series = "baseline"
                custom double campfire:valueSeconds = 0
                color3f[] primvars:displayColor = [(0.87, 0.25, 0.16)]
                double size = 1
                float3 xformOp:scale = (0.42, 0.42, 0.025)
                double3 xformOp:translate = (-2.1, 0, 0.025)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Cube "Calibrated"
            {
                custom int campfire:heatFluxKwM2 = 35
                custom string campfire:series = "calibrated"
                custom double campfire:valueSeconds = 0
                color3f[] primvars:displayColor = [(0.18, 0.68, 0.4)]
                double size = 1
                float3 xformOp:scale = (0.42, 0.42, 0.025)
                double3 xformOp:translate = (-2.1, 1.15, 0.025)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }

        def Xform "Flux70"
        {
            def Cube "Observed"
            {
                custom int campfire:heatFluxKwM2 = 70
                custom string campfire:series = "observed"
                custom double campfire:valueSeconds = 7.7
                color3f[] primvars:displayColor = [(0.95, 0.72, 0.39)]
                double size = 1
                float3 xformOp:scale = (0.42, 0.42, 0.28875)
                double3 xformOp:translate = (2.1, -1.15, 0.28875)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Cube "Baseline"
            {
                custom int campfire:heatFluxKwM2 = 70
                custom string campfire:series = "baseline"
                custom double campfire:valueSeconds = 0
                color3f[] primvars:displayColor = [(0.87, 0.25, 0.16)]
                double size = 1
                float3 xformOp:scale = (0.42, 0.42, 0.025)
                double3 xformOp:translate = (2.1, 0, 0.025)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Cube "Calibrated"
            {
                custom int campfire:heatFluxKwM2 = 70
                custom string campfire:series = "calibrated"
                custom double campfire:valueSeconds = 0
                color3f[] primvars:displayColor = [(0.18, 0.68, 0.4)]
                double size = 1
                float3 xformOp:scale = (0.42, 0.42, 0.025)
                double3 xformOp:translate = (2.1, 1.15, 0.025)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }
    }
}

