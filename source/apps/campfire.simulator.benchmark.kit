[package]
title = "Campfire Simulator Benchmark"
version = "0.1.0"
description = "Debugger-free Campfire Simulator application for controlled Phase 3 measurements."
keywords = ["app", "benchmark"]
template_name = "kit_base_editor"

[dependencies]
"campfire.app" = {}
"omni.flowusd" = {}
"omni.activity.profiler" = {}
"omni.activity.pump" = {}
"omni.anim.curve.core" = {}
"omni.graph.action" = {}
"omni.graph.core" = {}
"omni.graph.nodes" = {}
"omni.graph.scriptnode" = {}
"omni.graph.ui_nodes" = {}
"omni.hydra.engine.stats" = {}
"omni.hydra.rtx" = {}
"omni.hydra.usdrt_delegate" = {}
"omni.kit.mainwindow" = {}
"omni.kit.manipulator.camera" = {}
"omni.kit.manipulator.prim" = {}
"omni.kit.manipulator.selection" = {}
"omni.kit.material.library" = {}
"omni.kit.menu.common" = { order = 1000 }
"omni.kit.menu.create" = {}
"omni.kit.menu.edit" = {}
"omni.kit.menu.file" = {}
"omni.kit.primitive.mesh" = {}
"omni.kit.property.bundle" = {}
"omni.kit.raycast.query" = {}
"omni.kit.stage_template.core" = {}
"omni.kit.telemetry" = {}
"omni.kit.tool.asset_importer" = {}
"omni.kit.tool.collect" = {}
"omni.kit.viewport.legacy_gizmos" = {}
"omni.kit.viewport.menubar.camera" = {}
"omni.kit.viewport.menubar.display" = {}
"omni.kit.viewport.menubar.lighting" = {}
"omni.kit.viewport.menubar.render" = {}
"omni.kit.viewport.menubar.settings" = {}
"omni.kit.viewport.ready" = {}
"omni.kit.viewport.scene_camera_model" = {}
"omni.kit.viewport.window" = {}
"omni.kit.widget.cache_indicator" = {}
"omni.kit.window.console" = {}
"omni.kit.window.content_browser" = {}
"omni.kit.window.property" = {}
"omni.kit.window.stage" = {}
"omni.kit.window.status_bar" = {}
"omni.kit.window.toolbar" = {}
"omni.physx.stageupdate" = {}
"omni.rtx.settings.core" = {}
"omni.uiaudio" = {}
"omni.usd.metrics.assembler.ui" = {}
"omni.usd.schema.metrics.assembler" = {}
"omni.warp.core" = {}

[settings.persistent.app]
viewport.autoFrame.mode = "first_open"

[settings]
crashreporter.compressDumpFiles = true
exts."omni.kit.material.library".ui_show_list = ["OpenPBR Base", "OpenPBR", "OmniGlass", "OmniSurface", "USD Preview Surface", "Add MDL*", "Add MaterialX*"]
exts."omni.rtx.window.settings".window_menu = "Window"
exts."omni.kit.viewport.menubar.lighting".defaultRigIgnorePattern = ""
exts."omni.kit.viewport.window".windowMenu.entryCount = 1
exts."omni.kit.viewport.window".windowMenu.label = ""
renderer.gpuEnumeration.glInterop.enabled = false
renderer.asyncInit = true
rtx.ecoMode.enabled = true
rtx.hydra.mdlMaterialWarmup = true
rtx.rendermode = "RealTimePathTracing"
rtx.post.aa.op = 3
rtx.post.dlss.execMode = 0
rtx.rtpt.maxBounces = 2
telemetry.disableInternalSessionCheck = true
telemetry.enableAnonymousAppName = true
telemetry.enableAnonymousData = true
privacy.externalBuild = true

[settings.exts."campfire.app"]
autoCreateScene = true
captureOnStartup = false
outputDir = ""
phase = "phase3"
quitAfterCapture = false
sceneOutputDir = ""
woodArrayBackend = "python"
woodInternalTiming = false
woodSensibleHeatTiming = false
pythonConstantHeatCapacityFastPath = true
pythonHomogeneousHeatCapacityFastPath = true
pythonInlineHomogeneousSensibleHeatCapacityFastPath = true
pythonSlottedWoodCellStorage = true
pythonSurfaceBoundaryFastPath = true
woodStateDiagnostics = false
pythonStateClampFastPath = true
deferCellPhaseUpdates = true
compactRuntimeMetrics = true
precomputedRuntimeTopology = false
captureVideoFrames = false
captureMilestoneFrames = true
videoFrameIntervalSteps = 20
residentSnapshotAdapterEnabled = true
residentSnapshotTimingEnabled = false
residentSnapshotHandleCacheEnabled = true
residentSnapshotLightweightCommitEnabled = true
residentSnapshotSkipUnchangedEnabled = true
residentSnapshotLightweightTailTimingEnabled = false
residentSnapshotLightweightNoticeCoalescingEnabled = true
residentSnapshotLightweightNoticeTrackingEnabled = false
woodVisualV0Enabled = false
woodRenderHierarchyEnabled = true
woodVisualV3Enabled = true
residentNativeBackendEnabled = true
residentPointApplicationEnabled = false
residentPointRigidLayoutEnabled = false
residentPointRigidLifecycleQualificationEnabled = false
residentPointRecoveryQualificationEnabled = false
residentPointCommandQualificationEnabled = false
residentPointTransformQualificationEnabled = false
residentPointContinuityQualificationEnabled = false
residentPointContinuityFixQualificationEnabled = false
residentPointTimelineContinuityQualificationEnabled = false
residentPointDynamicTranslationQualificationEnabled = false
residentPointSkipUnchangedTranslationLayoutQualificationEnabled = false
residentNativeLibraryPath = ""

[settings.app]
content.emptyStageOnStart = true
font.file = "${fonts}/OpenSans-SemiBold.ttf"
font.size = 16
hangDetector.enabled = true
hangDetector.timeout = 120
renderer.skipWhileMinimized = true
window.title = "Campfire Simulator Benchmark"

[settings.app.environment]
name = "Campfire Simulator Benchmark"

[settings.app.exts]
folders.'++' = [
    "${app}/../exts",
    "${app}/../extscache/",
]

[settings.app.viewport.defaults]
fillViewport = false

[[test]]
args = ["--/app/file/ignoreUnsavedOnExit=true"]

[template]
type = "ApplicationTemplate"


